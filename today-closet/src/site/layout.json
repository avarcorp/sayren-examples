          "to": "/products?categoryId=cat_8645f5b34771"
        },
        {
          "image": "https://images.unsplash.com/photo-1584917865442-de89df76afd3?w=1000&h=700&fit=crop&q=80",
          "imageAlt": "레드 레더 토트백",
